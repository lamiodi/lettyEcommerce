# =========================================================
# LETTY Backend — Environment Variables
# Copy to `.env.local` and fill in real secrets.
# Never commit `.env.local` to source control.
# =========================================================

# ---------- App ----------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:4000
# Comma-separated list of origins allowed by CORS (the frontend)
FRONTEND_ORIGINS=http://localhost:3000

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Admin Auth (Edge-compatible JWT) ----------
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=

# ---------- Stripe (International: USD, EUR, GBP) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------- Paystack (Africa: NGN, GHS, ZAR, KES) ----------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---------- Algolia ----------
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ALGOLIA_SEARCH_KEY=
ALGOLIA_PRODUCTS_INDEX=letty_products
ALGOLIA_COLLECTIONS_INDEX=letty_collections
ALGOLIA_BRANDS_INDEX=letty_brands

# ---------- Upstash Redis ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Vercel QStash ----------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------- Resend (Transactional Email) ----------
RESEND_API_KEY=
EMAIL_FROM="LETTY <orders@letty.com>"

# ---------- Observability ----------
LOG_LEVEL=info
SENTRY_DSN=
