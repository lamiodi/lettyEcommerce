# ---------------------------------------------------------------------------
# LETTY backend — environment template
# Copy to .env (local) or set in Render (production). NEVER commit real values.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
# Public URL of this backend (used in emails/links)
NEXT_PUBLIC_SITE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (CORS)
FRONTEND_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Database — Supabase Postgres (service credentials; treat as secret)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production; customer auth fails closed without it.
JWT_SECRET_KEY=

# Stripe — use TEST keys locally (pk_test_/rk_test_/whsec_...), LIVE keys in production.
# The publishable key on the frontend and the secret key here must be the same mode.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="LETTY <concierge@houseofletty.com>"
EMAIL_OWNER_ALERT=owner@example.com

# Cloudinary (product media)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Rate limiting & caching are in-process (no external services needed).
# If you later scale to multiple backend instances, move lib/cache/redis.ts
# onto a shared store — all call sites go through that one facade.

# Background jobs (/api/jobs/*) — shared secret for external cron callers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cron calls must send it as header: x-jobs-secret: <value>
JOBS_SECRET_KEY=

# Algolia (search)
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ALGOLIA_SEARCH_KEY=
ALGOLIA_PRODUCTS_INDEX=letty_products
ALGOLIA_COLLECTIONS_INDEX=letty_collections
ALGOLIA_BRANDS_INDEX=letty_brands
