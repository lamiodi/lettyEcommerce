# ---------------------------------------------------------------------------
# LETTY frontend — environment template
# Copy to .env.local (local) or set in Vercel (production). NEVER commit real values.
# ---------------------------------------------------------------------------

# Base URL of the backend API (no trailing slash).
# Local dev with a local backend: http://localhost:4000
NEXT_PUBLIC_API_URL=https://lettyecommerce.onrender.com

# This site's public URL (canonical links, SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe PUBLISHABLE key only — the secret key lives in the backend.
# Must match the mode of the backend's STRIPE_SECRET_KEY (test with test, live with live).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudinary cloud name (serves product imagery)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
